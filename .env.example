# Daymark web application
# Enable API mode without embedding secrets in the client bundle.
VITE_DAYMARK_USE_API=false
# Leave empty for same-origin Railway or Vite dev proxy.
VITE_DAYMARK_API_URL=

# Control-plane / Railway service (server-side only)
PORT=3001
DATABASE_URL=postgresql://daymark:daymark@localhost:5432/daymark
DAYMARK_API_TOKEN=
DAYMARK_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DAYMARK_DEV_TOKEN=
DAYMARK_SEED_ON_START=0
# Comma-separated browser origins for local dev CORS.
DAYMARK_CORS_ORIGIN=http://localhost:4173,http://127.0.0.1:4173

# Proposed future integrations (server-side only)
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VERCEL_OIDC_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
BEE_API_URL=
BEE_API_TOKEN=
