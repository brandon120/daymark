{
  "name": "daymark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:railway": "vite build",
    "start": "node scripts/start-production.mjs",
    "preview": "vite preview",
    "test": "node --test tests/domain.test.mjs tests/today.contract.test.mjs tests/production-server.test.mjs",
    "test:integration": "node --test tests/api.integration.test.mjs",
    "check": "npm run test && npm run build && npm run test:sites",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "api": "npm run start -w @daymark/api",
    "api:dev": "npm run dev -w @daymark/api",
    "db:migrate": "node packages/database/migrate.mjs",
    "db:seed": "node packages/database/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@daymark/contracts": "0.0.0",
    "@daymark/domain": "0.0.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
